<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Same cinema-editorial tokens as the macOS Theme.swift: true-black
         canvas, one tungsten amber, hairlines. The light theme replaces
         these at launch (App.xaml.cs, LightPalette). -->
    <SolidColorBrush x:Key="VeltrioBackgroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="VeltrioBackgroundAltBrush" Color="#0A0A0A" />
    <SolidColorBrush x:Key="VeltrioSurfaceBrush" Color="#111111" />
    <SolidColorBrush x:Key="VeltrioSurfaceHoverBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="VeltrioSurfaceElevatedBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="VeltrioBorderBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="VeltrioBorderStrongBrush" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="VeltrioHairlineBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="VeltrioTextPrimaryBrush" Color="#FAF7F2" />
    <SolidColorBrush x:Key="VeltrioTextSecondaryBrush" Color="#ADFFFFFF" />
    <SolidColorBrush x:Key="VeltrioTextTertiaryBrush" Color="#6BFFFFFF" />
    <SolidColorBrush x:Key="VeltrioTextQuaternaryBrush" Color="#42FFFFFF" />
    <SolidColorBrush x:Key="VeltrioAccentBrush" Color="#E6A84B" />
    <SolidColorBrush x:Key="VeltrioAccentHoverBrush" Color="#F2BB64" />
    <SolidColorBrush x:Key="VeltrioAccentSoftBrush" Color="#24E6A84B" />
    <SolidColorBrush x:Key="VeltrioOnAccentBrush" Color="#1A1206" />
    <SolidColorBrush x:Key="VeltrioDangerBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="VeltrioSuccessBrush" Color="#4F9E5F" />
    <!-- Accent as text: darker on the light theme's paper (contrast). -->
    <SolidColorBrush x:Key="VeltrioAccentTextBrush" Color="#E6A84B" />
    <!-- The canvas, at several opacities, for the washes that fade
         artwork into the page. -->
    <Color x:Key="VeltrioCanvasColor">#FF000000</Color>
    <Color x:Key="VeltrioCanvas80Color">#CC000000</Color>
    <Color x:Key="VeltrioCanvas65Color">#A6000000</Color>
    <Color x:Key="VeltrioCanvas55Color">#8C000000</Color>
    <Color x:Key="VeltrioCanvas35Color">#59000000</Color>
    <Color x:Key="VeltrioCanvas0Color">#00000000</Color>

    <!-- Shared templates use {Binding}: x:Bind needs a code-behind class,
         which a plain resource dictionary doesn't have. -->

    <!-- ===================== Buttons ===================== -->

    <!-- Amber block, near-black uppercase label: "WATCH NOW" on macOS. -->
    <Style x:Key="VeltrioPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="#E6A84B" />
        <Setter Property="Foreground" Value="#1A1206" />
        <Setter Property="Padding" Value="24,14" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="240" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#F2BB64" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#C98F37" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Framed, transparent: the secondary action ("DETAILS", "SAVE"). -->
    <Style x:Key="VeltrioGhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource VeltrioTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VeltrioTextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="22,13" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="220" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource VeltrioBorderBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource VeltrioSurfaceElevatedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bare tracked text: "VIEW ALL →", "← BACK", the nav tabs. -->
    <Style x:Key="VeltrioLinkButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource VeltrioTextSecondaryBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="220" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{StaticResource VeltrioTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{StaticResource VeltrioAccentTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chip for filters (All / 4K / 1080p, Collection filters). -->
    <Style x:Key="VeltrioChip" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource VeltrioTextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VeltrioBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="180" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{StaticResource VeltrioTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#E6A84B" />
                                        <Setter Target="Root.BorderBrush" Value="#E6A84B" />
                                        <Setter Target="Content.Foreground" Value="#1A1206" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#F2BB64" />
                                        <Setter Target="Root.BorderBrush" Value="#F2BB64" />
                                        <Setter Target="Content.Foreground" Value="#1A1206" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#E6A84B" />
                                        <Setter Target="Content.Foreground" Value="#1A1206" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Items without the system selection chrome: posters carry their
         own hover frame. -->
    <Style x:Key="VeltrioBareListItem" TargetType="ListViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style x:Key="VeltrioBareGridItem" TargetType="GridViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,18,26" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style x:Key="VeltrioRowListItem" TargetType="ListViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- ===================== Data templates ===================== -->

    <!-- Portrait poster: sharp corners, hairline frame, serif title. -->
    <DataTemplate x:Key="PosterTemplate">
        <StackPanel Width="170" Spacing="8">
            <Grid Height="255" Background="{StaticResource VeltrioSurfaceBrush}" BorderBrush="{StaticResource VeltrioBorderBrush}" BorderThickness="1">
                <FontIcon Glyph="&#xE8B2;" FontSize="26" Foreground="{StaticResource VeltrioTextQuaternaryBrush}" />
                <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" />
            </Grid>
            <TextBlock Text="{Binding Title}" FontFamily="Georgia" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource VeltrioTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Subtitle}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{StaticResource VeltrioTextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </DataTemplate>

    <!-- Landscape card with a progress hairline: "Continue watching". -->
    <DataTemplate x:Key="ContinueTemplate">
        <StackPanel Width="300" Spacing="10">
            <Grid Height="169" Background="{StaticResource VeltrioSurfaceBrush}" BorderBrush="{StaticResource VeltrioBorderBrush}" BorderThickness="1">
                <FontIcon Glyph="&#xE8B2;" FontSize="26" Foreground="{StaticResource VeltrioTextQuaternaryBrush}" />
                <Image Source="{Binding Background}" Stretch="UniformToFill" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0.4" />
                            <GradientStop Color="#A6000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock Text="{Binding EpisodeCode}" Margin="10" VerticalAlignment="Bottom"
                           FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="SemiBold"
                           CharacterSpacing="120" Foreground="#E6A84B" />
                <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" VerticalAlignment="Bottom"
                             MinHeight="2" Height="2" CornerRadius="0" Background="{StaticResource VeltrioBorderBrush}" />
            </Grid>
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource VeltrioTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ResumeLabel}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{StaticResource VeltrioTextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Library poster with its status underneath. -->
    <DataTemplate x:Key="LibraryTemplate">
        <StackPanel Width="170" Spacing="8">
            <Grid Height="255" Background="{StaticResource VeltrioSurfaceBrush}" BorderBrush="{StaticResource VeltrioBorderBrush}" BorderThickness="1">
                <FontIcon Glyph="&#xE8B2;" FontSize="26" Foreground="{StaticResource VeltrioTextQuaternaryBrush}" />
                <Image Source="{Binding Poster}" Stretch="UniformToFill" />
                <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" VerticalAlignment="Bottom"
                             MinHeight="2" Height="2" CornerRadius="0" Background="Transparent" />
            </Grid>
            <TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource VeltrioTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding StatusLabel}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{StaticResource VeltrioTextTertiaryBrush}" TextTrimming="CharacterEllipsis" CharacterSpacing="160" />
        </StackPanel>
    </DataTemplate>

    <!-- Live TV tile: logo on a dark plate, name below. -->
    <DataTemplate x:Key="ChannelTemplate">
        <StackPanel Width="190" Spacing="8">
            <Grid Height="107" Background="{StaticResource VeltrioSurfaceBrush}" BorderBrush="{StaticResource VeltrioBorderBrush}" BorderThickness="1">
                <FontIcon Glyph="&#xE7F4;" FontSize="22" Foreground="{StaticResource VeltrioTextQuaternaryBrush}" />
                <Image Source="{Binding Logo}" Stretch="Uniform" Margin="22,16" />
            </Grid>
            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource VeltrioTextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Group}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{StaticResource VeltrioTextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
