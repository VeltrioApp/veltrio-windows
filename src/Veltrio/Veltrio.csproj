<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Veltrio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Veltrio.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged (no MSIX for now) and self-contained: the Windows App
         SDK runtime ships with the app instead of being a separate install. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Generates Veltrio.pri (the compiled XAML) for publish too; without
         it a published unpackaged app dies at startup loading App.xaml. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <!-- The UniFFI bindings use unsafe code for the FFI buffers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Generated bindings trip nullable and naming analyzers. -->
    <NoWarn>$(NoWarn);CS8618;CS8625;CS8603;CS0108;CS1591</NoWarn>
    <Version>0.1.0</Version>
    <!-- Program.cs is the entry point, so Velopack runs before XAML starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <!-- The player: Direct3D 11 / DXGI bindings, and ANGLE (GL ES over
         D3D11) so libmpv's OpenGL renderer can draw into a SwapChainPanel. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Avalonia.Angle.Windows.Natives" Version="2.1.25547.20250602" />
    <!-- Installer and updates from the GitHub releases. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- Account services' app ids, from environment variables; empty = the
       service is off. Trakt: an app at trakt.tv/oauth/applications.
       SIMKL: a client id from simkl.com/settings/developer. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TraktClientId</_Parameter1>
      <_Parameter2>$(VELTRIO_TRAKT_CLIENT_ID)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TraktClientSecret</_Parameter1>
      <_Parameter2>$(VELTRIO_TRAKT_CLIENT_SECRET)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SimklClientId</_Parameter1>
      <_Parameter2>$(VELTRIO_SIMKL_CLIENT_ID)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Veltrio.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The Rust core, downloaded by scripts/fetch-core.sh into core/. -->
  <ItemGroup>
    <Compile Include="..\..\core\Bindings\veltrio.cs" Link="Core\veltrio.cs" />
    <None Include="..\..\core\veltrio_core.dll" Link="veltrio_core.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- libmpv (LGPL build), downloaded by scripts/fetch-mpv.sh into mpv/. -->
  <ItemGroup>
    <None Include="..\..\mpv\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\mpv\cacert.pem" Link="cacert.pem" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
