<Page
    x:Class="Veltrio.Pages.AddonCatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- {Binding}: see DetailPage.xaml about x:Bind in page templates. -->
        <DataTemplate x:Key="AddonTemplate">
            <Grid Padding="0,16" ColumnSpacing="18" BorderBrush="{StaticResource VeltrioBorderBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="52" Height="52" Background="{StaticResource VeltrioSurfaceBrush}" VerticalAlignment="Top">
                    <FontIcon Glyph="&#xEA86;" FontSize="18" Foreground="{StaticResource VeltrioTextQuaternaryBrush}" />
                    <Image Source="{Binding Logo}" Stretch="Uniform" Margin="6" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource VeltrioSerif}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource VeltrioTextPrimaryBrush}" />
                        <TextBlock Text="{Binding Version}" Style="{StaticResource VeltrioCaption}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Meta}" Style="{StaticResource VeltrioCaption}" CharacterSpacing="80" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource VeltrioBody}" FontSize="12" MaxLines="2"
                               TextTrimming="WordEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource VeltrioPrimaryButton}" Padding="20,9" VerticalAlignment="Center"
                        Content="{Binding InstallLabel}" IsEnabled="{Binding CanInstall}" Tag="{Binding}" Click="OnInstall" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="48,28,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="10" Padding="0,0,48,16">
            <Button Style="{StaticResource VeltrioLinkButton}" Click="OnBack">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="9" />
                    <TextBlock Text="RETOUR" />
                </StackPanel>
            </Button>
            <TextBlock Text="SOURCES" Style="{StaticResource VeltrioAccentEyebrow}" Margin="0,8,0,0" />
            <TextBlock Text="Catalogue d'addons" Style="{StaticResource VeltrioPageTitle}" />
            <TextBlock Style="{StaticResource VeltrioBody}" MaxWidth="760" HorizontalAlignment="Left"
                       Text="La collection officielle de Stremio et les centaines d'addons de stremio-addons.net, installables sans quitter l'app." />
            <Grid Margin="0,8,0,0">
                <StackPanel x:Name="SourceChips" Orientation="Horizontal" Spacing="8" />
                <TextBox x:Name="Filter" HorizontalAlignment="Right" Width="300" PlaceholderText="Chercher un addon par nom…"
                         TextChanged="OnFilterChanged" />
            </Grid>
            <TextBlock x:Name="Message" Foreground="{StaticResource VeltrioDangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <Border Style="{StaticResource VeltrioRule}" Margin="0,8,0,0" />
        </StackPanel>

        <ListView x:Name="List" Grid.Row="1" SelectionMode="None" ItemTemplate="{StaticResource AddonTemplate}"
                  ItemContainerStyle="{StaticResource VeltrioRowListItem}" Padding="0,0,48,40">
            <ListView.Footer>
                <StackPanel Padding="0,16,0,40" Spacing="12">
                    <ProgressRing x:Name="Loading" IsActive="False" Width="22" Height="22" HorizontalAlignment="Left" />
                    <Button x:Name="LoadMore" Style="{StaticResource VeltrioGhostButton}" Click="OnLoadMore" Visibility="Collapsed">
                        <TextBlock Text="CHARGER PLUS" />
                    </Button>
                </StackPanel>
            </ListView.Footer>
        </ListView>
    </Grid>
</Page>
