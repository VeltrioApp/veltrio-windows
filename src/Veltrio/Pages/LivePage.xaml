<Page
    x:Class="Veltrio.Pages.LivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="48,32,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="0,0,48,24">
            <StackPanel Spacing="10">
                <TextBlock x:Name="Eyebrow" Text="DIRECT" Style="{StaticResource VeltrioAccentEyebrow}" />
                <TextBlock Text="TV en direct" Style="{StaticResource VeltrioPageTitle}" />
            </StackPanel>
            <StackPanel x:Name="Toolbar" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" Visibility="Collapsed">
                <ComboBox x:Name="PlaylistPicker" MinWidth="220" SelectionChanged="OnPlaylistChanged" />
                <Button Style="{StaticResource VeltrioLinkButton}" Padding="6" Click="OnRefresh" ToolTipService.ToolTip="Actualiser">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <TextBox x:Name="Filter" PlaceholderText="Rechercher une chaîne" Width="260" TextChanged="OnFilterChanged" />
            </StackPanel>
            <Border Style="{StaticResource VeltrioRule}" VerticalAlignment="Bottom" Margin="0,0,0,-24" />
        </Grid>

        <!-- No playlist yet. -->
        <StackPanel x:Name="EmptyState" Grid.Row="1" Spacing="18" Padding="0,24,48,0" MaxWidth="560" HorizontalAlignment="Left"
                    Visibility="Collapsed">
            <TextBlock Text="Silence radio." Style="{StaticResource VeltrioPageTitle}" FontSize="38" />
            <TextBlock Style="{StaticResource VeltrioBody}"
                       Text="Ajoutez l'URL d'une playlist M3U pour regarder la télé. Les identifiants ne quittent jamais cet appareil." />
            <Button Style="{StaticResource VeltrioPrimaryButton}" Click="OnOpenSources" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="AJOUTER UNE PLAYLIST" />
                    <FontIcon Glyph="&#xE72A;" FontSize="10" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid x:Name="Browser" Grid.Row="1" Visibility="Collapsed" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="Groups" SelectionMode="Single" SelectionChanged="OnGroupChanged" Padding="0,0,0,40">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,2">
                            <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,40,0" />
                            <TextBlock Text="{Binding Count}" HorizontalAlignment="Right" FontFamily="{StaticResource VeltrioMono}"
                                       FontSize="10" Foreground="{StaticResource VeltrioTextTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Column="1" Padding="28,0,0,0">
                <ProgressRing x:Name="Loading" IsActive="False" Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <TextBlock x:Name="Message" Style="{StaticResource VeltrioBody}" Visibility="Collapsed" />
                <GridView x:Name="Channels" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnChannelClick"
                          ItemTemplate="{StaticResource ChannelTemplate}" ItemContainerStyle="{StaticResource VeltrioBareGridItem}"
                          Padding="0,0,30,40" />
            </Grid>
        </Grid>
    </Grid>
</Page>
