<Page
    x:Class="Veltrio.Pages.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Veltrio.Pages"
    Background="Black"
    IsTabStop="True" UseSystemFocusVisuals="False">

    <Page.Resources>
        <local:TimeLabelConverter x:Key="TimeLabel" />
        <DataTemplate x:Key="ZapTemplate">
            <Grid Padding="12,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Number}" FontFamily="{StaticResource VeltrioMono}" FontSize="11" Foreground="#99FFFFFF"
                           VerticalAlignment="Center" />
                <Grid Grid.Column="1" Width="40" Height="28" Background="#22FFFFFF">
                    <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="#66FFFFFF" />
                    <Image Source="{Binding Logo}" Stretch="Uniform" Margin="3" />
                </Grid>
                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#FAF7F2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding NowTitle}" FontSize="11" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding NowVisibility}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ReplayTemplate">
            <Grid Padding="14,9" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeRange}" FontFamily="{StaticResource VeltrioMono}" FontSize="10" Foreground="#BFFFFFFF"
                           TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource VeltrioSerif}" FontSize="13" FontWeight="SemiBold"
                               Foreground="#FAF7F2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <FontIcon Grid.Column="2" Glyph="&#xE768;" FontSize="10" Foreground="{StaticResource VeltrioAccentBrush}" />
            </Grid>
        </DataTemplate>
        <Style x:Key="SidePanelTitle" TargetType="TextBlock" BasedOn="{StaticResource VeltrioAccentEyebrow}">
            <Setter Property="Margin" Value="16,0,16,6" />
        </Style>
        <Style x:Key="PlayerIconButton" TargetType="Button" BasedOn="{StaticResource VeltrioLinkButton}">
            <Setter Property="Foreground" Value="#FAF7F2" />
            <Setter Property="Padding" Value="8" />
        </Style>
    </Page.Resources>

    <Grid x:Name="Root" PointerMoved="OnPointerMoved" Tapped="OnSurfaceTapped" DoubleTapped="OnSurfaceDoubleTapped"
          Background="Black">
        <!-- mpv draws here (libmpv → ANGLE → D3D11 swapchain). -->
        <SwapChainPanel x:Name="Video" />

        <!-- Top: back, title, live badge, full screen. -->
        <Grid x:Name="TopBar" VerticalAlignment="Top" Padding="28,22,28,48">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B3000000" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <StackPanel Orientation="Horizontal" Spacing="22">
                <Button Style="{StaticResource VeltrioLinkButton}" Click="OnClose" Foreground="#FAF7F2"
                        AutomationProperties.Name="Retour">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="10" />
                        <TextBlock Text="RETOUR" />
                    </StackPanel>
                </Button>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource VeltrioSerif}" FontSize="20" FontWeight="SemiBold"
                               Foreground="#FAF7F2" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource VeltrioCaption}" Foreground="#BFFFFFFF" />
                    <TextBlock x:Name="EpgLine" FontSize="12" Foreground="#E6FFFFFF" Margin="0,4,0,0" Visibility="Collapsed"
                               TextTrimming="CharacterEllipsis" MaxWidth="900" />
                </StackPanel>
                <Border x:Name="LiveBadge" Background="{StaticResource VeltrioDangerBrush}" Padding="8,2" VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock Text="DIRECT" FontSize="9" FontWeight="Bold" CharacterSpacing="200" Foreground="White" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Live: the playlist's channels, to zap without leaving. -->
        <Grid x:Name="ChannelPanel" Width="380" HorizontalAlignment="Right" Background="#E6080808" Visibility="Collapsed"
              Padding="0,70,0,110">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="ChannelPanelTitle" Style="{StaticResource VeltrioAccentEyebrow}" Margin="16,0,16,10" />
            <ListView x:Name="ZapList" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnZapClick"
                      ItemTemplate="{StaticResource ZapTemplate}" ItemContainerStyle="{StaticResource VeltrioRowListItem}" />
        </Grid>

        <!-- Live: now and next, on tune-in and with the controls. -->
        <StackPanel x:Name="EpgCards" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,128,0,0" Spacing="10"
                    MaxWidth="460" Visibility="Collapsed" IsHitTestVisible="False" />

        <!-- Replay: the past programmes the provider keeps. -->
        <Grid x:Name="ReplayPanel" Width="420" HorizontalAlignment="Right" Background="#E6080808" Visibility="Collapsed"
              Padding="0,70,0,110">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="REPLAY" Style="{StaticResource SidePanelTitle}" />
            <TextBlock x:Name="ReplayHint" Grid.Row="1" Margin="16,0,16,10" FontSize="11" Foreground="#99FFFFFF" TextWrapping="Wrap"
                       Text="Revenez à un programme passé : il reprend depuis son début." />
            <ProgressRing x:Name="ReplayLoading" Grid.Row="2" IsActive="False" Width="22" Height="22" VerticalAlignment="Top" />
            <ListView x:Name="ReplayList" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnReplayClick"
                      ItemTemplate="{StaticResource ReplayTemplate}" ItemContainerStyle="{StaticResource VeltrioRowListItem}" />
        </Grid>

        <!-- Media info: codecs, resolution, HDR, tracks (I). -->
        <Grid x:Name="InfoPanel" Width="380" HorizontalAlignment="Right" Background="#E6080808" Visibility="Collapsed"
              Padding="0,70,0,110">
            <ScrollViewer>
                <StackPanel x:Name="InfoLines" Spacing="6" Padding="16,0,16,16" />
            </ScrollViewer>
        </Grid>

        <!-- Skip intro, when the chapter playing reads like one (S). -->
        <Button x:Name="SkipIntroButton" Style="{StaticResource VeltrioPrimaryButton}" HorizontalAlignment="Right"
                VerticalAlignment="Bottom" Margin="0,0,28,140" Visibility="Collapsed" Click="OnSkipIntro">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE893;" FontSize="11" />
                <TextBlock Text="PASSER L'INTRO" />
            </StackPanel>
        </Button>

        <!-- Next episode, at the end of one. -->
        <Grid x:Name="NextOverlay" Background="#B3000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="560">
                <TextBlock Text="ÉPISODE SUIVANT" Style="{StaticResource VeltrioAccentEyebrow}" HorizontalAlignment="Center" />
                <TextBlock x:Name="NextTitle" FontFamily="{StaticResource VeltrioSerif}" FontSize="30" FontWeight="Bold"
                           Foreground="#FAF7F2" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="NextCountdown" FontFamily="{StaticResource VeltrioMono}" FontSize="12" Foreground="#BFFFFFFF"
                           HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button Style="{StaticResource VeltrioGhostButton}" Click="OnCancelNext">
                        <TextBlock Text="ANNULER" />
                    </Button>
                    <Button x:Name="PlayNextButton" Style="{StaticResource VeltrioPrimaryButton}" Click="OnPlayNext">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE768;" FontSize="11" />
                            <TextBlock Text="LIRE MAINTENANT" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Centre: preparing, buffering, or what went wrong. -->
        <StackPanel x:Name="Status" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" MaxWidth="560">
            <ProgressRing x:Name="Busy" IsActive="True" Width="36" Height="36" Foreground="{StaticResource VeltrioAccentBrush}" />
            <TextBlock x:Name="StatusText" Text="Préparation du flux…" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Foreground="#BFFFFFFF" />
            <Button x:Name="RetryButton" Style="{StaticResource VeltrioGhostButton}" HorizontalAlignment="Center"
                    Visibility="Collapsed" Click="OnRetry">
                <TextBlock Text="RÉESSAYER" />
            </Button>
        </StackPanel>

        <!-- Bottom: scrubber, time, transport, tracks, speed, volume. -->
        <Grid x:Name="BottomBar" VerticalAlignment="Bottom" Padding="28,60,28,20">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#CC000000" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="ScrubRow" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PositionText" Text="0:00" VerticalAlignment="Center" FontFamily="{StaticResource VeltrioMono}"
                           FontSize="12" Foreground="#FAF7F2" />
                <Slider x:Name="Scrubber" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="1"
                        IsThumbToolTipEnabled="True" ThumbToolTipValueConverter="{StaticResource TimeLabel}"
                        ValueChanged="OnScrub" AutomationProperties.Name="Position" />
                <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" VerticalAlignment="Center"
                           FontFamily="{StaticResource VeltrioMono}" FontSize="12" Foreground="#BFFFFFFF" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="MuteButton" Style="{StaticResource PlayerIconButton}" Click="OnToggleMute"
                            ToolTipService.ToolTip="Muet (M)" AutomationProperties.Name="Muet">
                        <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="16" />
                    </Button>
                    <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="130" Value="100" VerticalAlignment="Center"
                            ValueChanged="OnVolume" AutomationProperties.Name="Volume" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center">
                    <Button x:Name="BackButton" Style="{StaticResource PlayerIconButton}" Click="OnBack10"
                            ToolTipService.ToolTip="Reculer de 10 s (←)" AutomationProperties.Name="Reculer de 10 secondes">
                        <FontIcon Glyph="&#xED3C;" FontSize="20" />
                    </Button>
                    <Button x:Name="PlayPauseButton" Style="{StaticResource PlayerIconButton}" Click="OnTogglePause"
                            ToolTipService.ToolTip="Lecture / pause (Espace)" AutomationProperties.Name="Lecture ou pause">
                        <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE769;" FontSize="26" />
                    </Button>
                    <Button x:Name="ForwardButton" Style="{StaticResource PlayerIconButton}" Click="OnForward30"
                            ToolTipService.ToolTip="Avancer de 30 s (→)" AutomationProperties.Name="Avancer de 30 secondes">
                        <FontIcon Glyph="&#xED3D;" FontSize="20" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="NextButton" Style="{StaticResource PlayerIconButton}" ToolTipService.ToolTip="Épisode suivant (N)"
                            AutomationProperties.Name="Épisode suivant" Visibility="Collapsed" Click="OnPlayNext">
                        <FontIcon Glyph="&#xE893;" FontSize="16" />
                    </Button>
                    <Button x:Name="ReplayButton" Style="{StaticResource PlayerIconButton}" ToolTipService.ToolTip="Revoir un programme"
                            AutomationProperties.Name="Revoir" Visibility="Collapsed" Click="OnReplay">
                        <FontIcon Glyph="&#xE81C;" FontSize="16" />
                    </Button>
                    <Button x:Name="ChannelsButton" Style="{StaticResource PlayerIconButton}" ToolTipService.ToolTip="Chaînes (Pg préc. / Pg suiv.)"
                            AutomationProperties.Name="Chaînes" Visibility="Collapsed" Click="OnToggleChannels">
                        <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                    </Button>
                    <Button x:Name="AudioButton" Style="{StaticResource PlayerIconButton}" ToolTipService.ToolTip="Audio"
                            AutomationProperties.Name="Pistes audio">
                        <FontIcon Glyph="&#xE8D6;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="AudioMenu" Placement="Top" />
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="SubtitleButton" Style="{StaticResource PlayerIconButton}" ToolTipService.ToolTip="Sous-titres"
                            AutomationProperties.Name="Sous-titres">
                        <FontIcon Glyph="&#xED1E;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="SubtitleMenu" Placement="Top" />
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="SpeedButton" Style="{StaticResource PlayerIconButton}" ToolTipService.ToolTip="Vitesse"
                            AutomationProperties.Name="Vitesse">
                        <TextBlock x:Name="SpeedLabel" Text="1×" FontFamily="{StaticResource VeltrioMono}" FontSize="13" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="SpeedMenu" Placement="Top" />
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="InfoButton" Style="{StaticResource PlayerIconButton}" Click="OnToggleInfo"
                            ToolTipService.ToolTip="Infos média (I)" AutomationProperties.Name="Infos média">
                        <FontIcon Glyph="&#xE946;" FontSize="16" />
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource PlayerIconButton}" ToolTipService.ToolTip="Image, son et décalages"
                            AutomationProperties.Name="Réglages de lecture">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="SettingsMenu" Placement="Top" Opening="OnSettingsOpening" />
                        </Button.Flyout>
                    </Button>
                    <Button Style="{StaticResource PlayerIconButton}" Click="OnToggleFullScreen"
                            ToolTipService.ToolTip="Plein écran (F)" AutomationProperties.Name="Plein écran">
                        <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
