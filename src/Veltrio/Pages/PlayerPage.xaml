<Page
    x:Class="Veltrio.Pages.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:player="using:Veltrio.Player"
    Background="Black" RequestedTheme="Dark"
    IsTabStop="True" UseSystemFocusVisuals="False">

    <!-- The macOS player, control for control: glass buttons along the top,
         a thin amber seek bar, the transport and volume at the bottom. The
         chrome sits on dark scrims over the picture, so it stays dark in
         the light theme too. -->
    <Page.Resources>
        <!-- "Glass" circle: ultraThinMaterial on macOS; WinUI can't blur a
             swapchain, so a translucent fill with the same hairline. -->
        <SolidColorBrush x:Key="GlassFill" Color="#73262626" />
        <SolidColorBrush x:Key="GlassFillHover" Color="#A6333333" />
        <SolidColorBrush x:Key="GlassStroke" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="PanelFill" Color="#D90D0D0D" />
        <SolidColorBrush x:Key="PanelStroke" Color="#1AFFFFFF" />

        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Disc.Fill" Value="{StaticResource GlassFillHover}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Disc.Fill" Value="{StaticResource GlassFillHover}" />
                                            <Setter Target="Content.Opacity" Value="0.7" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Content.Opacity" Value="0.35" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Ellipse x:Name="Disc" Fill="{StaticResource GlassFill}" Stroke="{StaticResource GlassStroke}" StrokeThickness="1" />
                            <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill: Back, the end-of-episode choices. -->
        <Style x:Key="CapsuleButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource GlassFill}" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Content.Opacity" Value="0.85" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Content.Opacity" Value="0.7" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Content.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource GlassStroke}"
                                    BorderThickness="1" CornerRadius="999" Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="Content" Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The small ✕ at the top of the side panels. -->
        <Style x:Key="PanelCloseButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Width="24" Height="24" BorderBrush="#33FFFFFF" BorderThickness="1" Background="Transparent">
                            <FontIcon Glyph="&#xE711;" FontSize="9" Foreground="White" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassIcon" TargetType="FontIcon">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Badge in the corner of a glass button: "1.5×", "16:9", a count. -->
        <Style x:Key="GlassBadge" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,-16,-16" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="GlassBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Foreground" Value="Black" />
        </Style>

        <Style x:Key="PanelEyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="260" />
            <Setter Property="Foreground" Value="#E6A84B" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="ZapTemplate">
            <Grid Padding="0,7,14,7" ColumnSpacing="8" Background="{Binding RowBackground}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Fill="#E6A84B" Opacity="{Binding CurrentOpacity}" />
                <TextBlock Grid.Column="1" Text="{Binding Number}" FontFamily="{StaticResource VeltrioMono}" FontSize="10"
                           FontWeight="SemiBold" Foreground="{Binding NumberBrush}" VerticalAlignment="Center" />
                <Grid Grid.Column="2" Width="44" Height="30" Background="#14FFFFFF">
                    <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="#66FFFFFF" />
                    <Image Source="{Binding Logo}" Stretch="Uniform" Margin="3" />
                </Grid>
                <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding NowTitle}" FontSize="10" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding NowVisibility}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ReplayTemplate">
            <Grid Padding="10,8" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StartLabel}" FontFamily="{StaticResource VeltrioMono}" FontSize="10" FontWeight="SemiBold"
                           Foreground="#BFFFFFFF" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource VeltrioSerif}" FontSize="13" FontWeight="SemiBold"
                               Foreground="White" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <FontIcon Grid.Column="2" Glyph="&#xE768;" FontSize="9" Foreground="#E6A84B" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="Root" PointerMoved="OnPointerMoved" Tapped="OnSurfaceTapped" Background="Black">
        <!-- mpv draws here (libmpv → ANGLE → D3D11 swapchain). -->
        <SwapChainPanel x:Name="Video" />

        <!-- Centre: loading, or what went wrong. -->
        <StackPanel x:Name="Status" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="440">
            <FontIcon x:Name="ErrorIcon" Glyph="&#xE7BA;" FontSize="42" Foreground="#FFD60A" Visibility="Collapsed" />
            <ProgressRing x:Name="Busy" IsActive="True" Width="32" Height="32" Foreground="White" />
            <TextBlock x:Name="StatusText" Text="Chargement du flux…" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Foreground="#E6FFFFFF" FontSize="13" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusDetail" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="#99FFFFFF" FontSize="12" />
            <StackPanel x:Name="ErrorActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0"
                        Visibility="Collapsed">
                <Button x:Name="RetryButton" Style="{StaticResource VeltrioPrimaryButton}" Click="OnRetry">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="11" />
                        <TextBlock Text="RÉESSAYER" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource VeltrioGhostButton}" Click="OnClose" Foreground="White" BorderBrush="White">
                    <TextBlock Text="RETOUR" />
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Buffering: a spinner in a dark disc. -->
        <Grid x:Name="BufferRing" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center"
              Visibility="Collapsed" IsHitTestVisible="False">
            <Ellipse Fill="#66000000" />
            <ProgressRing IsActive="True" Width="34" Height="34" Foreground="White" />
        </Grid>

        <!-- Top: Back, live badge, channel logo, title; the glass buttons. -->
        <Grid x:Name="TopBar" VerticalAlignment="Top" Padding="36,36,36,22" ColumnSpacing="14">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#A6000000" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Button Style="{StaticResource CapsuleButton}" Click="OnClose" AutomationProperties.Name="Retour">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE76B;" FontSize="11" />
                        <TextBlock Text="Retour" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Border x:Name="LiveBadge" Background="#8C000000" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1"
                        CornerRadius="999" Padding="14,6" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="7" Height="7" Fill="#E5484D" VerticalAlignment="Center" />
                        <TextBlock Text="DIRECT" FontSize="11" FontWeight="Black" CharacterSpacing="60" Foreground="White" />
                    </StackPanel>
                </Border>
                <Grid x:Name="ChannelLogo" Width="44" Height="44" Visibility="Collapsed">
                    <Ellipse Fill="{StaticResource GlassFill}" Stroke="#26FFFFFF" StrokeThickness="1" />
                    <Image x:Name="ChannelLogoImage" Width="36" Height="36" Stretch="Uniform" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubtitleText" FontSize="11" FontWeight="Medium" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Button x:Name="ChannelsButton" Style="{StaticResource GlassButton}" Visibility="Collapsed" Click="OnToggleChannels"
                        ToolTipService.ToolTip="Chaînes (L)" AutomationProperties.Name="Chaînes">
                    <FontIcon Glyph="&#xE8FD;" Style="{StaticResource GlassIcon}" />
                </Button>
                <Button x:Name="AudioButton" Style="{StaticResource GlassButton}" Visibility="Collapsed"
                        ToolTipService.ToolTip="Piste audio" AutomationProperties.Name="Pistes audio">
                    <FontIcon Glyph="&#xE8D6;" Style="{StaticResource GlassIcon}" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="AudioMenu" Placement="Bottom" />
                    </Button.Flyout>
                </Button>
                <Button x:Name="SubtitleButton" Style="{StaticResource GlassButton}"
                        ToolTipService.ToolTip="Sous-titres (Z / X pour le décalage)" AutomationProperties.Name="Sous-titres">
                    <Grid>
                        <FontIcon x:Name="SubtitleIcon" Glyph="&#xED1E;" Style="{StaticResource GlassIcon}" />
                        <Border x:Name="SubtitleBadge" Style="{StaticResource GlassBadge}">
                            <TextBlock Text="…" Style="{StaticResource GlassBadgeText}" />
                        </Border>
                    </Grid>
                    <Button.Flyout>
                        <MenuFlyout x:Name="SubtitleMenu" Placement="Bottom" />
                    </Button.Flyout>
                </Button>
                <Button x:Name="SpeedButton" Style="{StaticResource GlassButton}"
                        ToolTipService.ToolTip="Vitesse de lecture" AutomationProperties.Name="Vitesse">
                    <Grid>
                        <FontIcon Glyph="&#xEC4A;" Style="{StaticResource GlassIcon}" />
                        <Border x:Name="SpeedBadge" Style="{StaticResource GlassBadge}">
                            <TextBlock x:Name="SpeedBadgeText" Style="{StaticResource GlassBadgeText}" />
                        </Border>
                    </Grid>
                    <Button.Flyout>
                        <MenuFlyout x:Name="SpeedMenu" Placement="Bottom" />
                    </Button.Flyout>
                </Button>
                <Button x:Name="PipButton" Style="{StaticResource GlassButton}" Click="OnTogglePip"
                        ToolTipService.ToolTip="Image dans l'image (CompactOverlay)" AutomationProperties.Name="Image dans l'image">
                    <FontIcon Glyph="&#xEE49;" Style="{StaticResource GlassIcon}" />
                </Button>
                <Button x:Name="AspectButton" Style="{StaticResource GlassButton}"
                        ToolTipService.ToolTip="Format d'image et zoom" AutomationProperties.Name="Format d'image">
                    <Grid>
                        <FontIcon Glyph="&#xE799;" Style="{StaticResource GlassIcon}" />
                        <Border x:Name="AspectBadge" Style="{StaticResource GlassBadge}">
                            <TextBlock x:Name="AspectBadgeText" Style="{StaticResource GlassBadgeText}" />
                        </Border>
                    </Grid>
                    <Button.Flyout>
                        <MenuFlyout x:Name="AspectMenu" Placement="Bottom" Opening="OnAspectOpening" />
                    </Button.Flyout>
                </Button>
                <Button x:Name="ProfileButton" Style="{StaticResource GlassButton}"
                        ToolTipService.ToolTip="Préréglages image et son" AutomationProperties.Name="Préréglages">
                    <Grid>
                        <FontIcon Glyph="&#xE9E9;" Style="{StaticResource GlassIcon}" />
                        <Border x:Name="ProfileBadge" Style="{StaticResource GlassBadge}">
                            <TextBlock x:Name="ProfileBadgeText" Style="{StaticResource GlassBadgeText}" />
                        </Border>
                    </Grid>
                    <Button.Flyout>
                        <MenuFlyout x:Name="ProfileMenu" Placement="Bottom" Opening="OnProfileOpening" />
                    </Button.Flyout>
                </Button>
                <Button x:Name="CastButton" Style="{StaticResource GlassButton}"
                        ToolTipService.ToolTip="Diffuser sur un Chromecast" AutomationProperties.Name="Chromecast">
                    <FontIcon Glyph="&#xEC15;" Style="{StaticResource GlassIcon}" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="CastMenu" Placement="Bottom" Opening="OnCastOpening" />
                    </Button.Flyout>
                </Button>
                <Button x:Name="ReplayButton" Style="{StaticResource GlassButton}" Visibility="Collapsed" Click="OnReplay"
                        ToolTipService.ToolTip="Replay" AutomationProperties.Name="Replay">
                    <Grid>
                        <FontIcon Glyph="&#xE81C;" Style="{StaticResource GlassIcon}" />
                        <Border x:Name="ReplayBadge" Style="{StaticResource GlassBadge}">
                            <TextBlock x:Name="ReplayBadgeText" Style="{StaticResource GlassBadgeText}" />
                        </Border>
                    </Grid>
                </Button>
                <Button x:Name="InfoButton" Style="{StaticResource GlassButton}" Click="OnToggleInfo"
                        ToolTipService.ToolTip="Infos média (I)" AutomationProperties.Name="Infos média">
                    <FontIcon x:Name="InfoIcon" Glyph="&#xE946;" Style="{StaticResource GlassIcon}" />
                </Button>
                <Button Style="{StaticResource GlassButton}" Click="OnToggleFullScreen"
                        ToolTipService.ToolTip="Plein écran (F)" AutomationProperties.Name="Plein écran">
                    <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" Style="{StaticResource GlassIcon}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Live: NOW and NEXT over the picture, bottom left (G). -->
        <StackPanel x:Name="EpgCards" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="36,0,0,120" Spacing="10"
                    MaxWidth="440" Visibility="Collapsed" IsHitTestVisible="False" />

        <!-- Skip intro, when the chapter playing reads like one (S). -->
        <Button x:Name="SkipIntroButton" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,36,130"
                Visibility="Collapsed" Click="OnSkipIntro" AutomationProperties.Name="Passer l'intro">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#E6A84B" Padding="20,14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE893;" FontSize="11" Foreground="#1A1206" />
                            <TextBlock Text="PASSER L'INTRO" FontSize="11" FontWeight="ExtraBold" CharacterSpacing="240" Foreground="#1A1206" />
                            <Rectangle Width="18" Height="1" Fill="#1A1206" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Bottom: the seek bar, then the transport and the volume. -->
        <Grid x:Name="BottomBar" VerticalAlignment="Bottom" Padding="36,22,36,36" RowSpacing="14">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#BF000000" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="ScrubRow" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="54" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PositionText" Text="0:00" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="White" />
                <Grid Grid.Column="1">
                    <player:SeekSlider x:Name="Scrubber" AutomationProperties.Name="Position" />
                    <!-- Time and chapter where the pointer is. -->
                    <Border x:Name="ScrubTip" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-46,0,0" Padding="10,6"
                            Background="#D9000000" BorderBrush="#1FFFFFFF" BorderThickness="1" Visibility="Collapsed"
                            IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ScrubTipOffset" />
                        </Border.RenderTransform>
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock x:Name="ScrubTipChapter" FontSize="9" FontWeight="Bold" CharacterSpacing="140" Foreground="#E6A84B"
                                       HorizontalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                            <TextBlock x:Name="ScrubTipTime" FontFamily="{StaticResource VeltrioMono}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock x:Name="RemainingText" Grid.Column="2" Text="-0:00" VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontSize="11" FontWeight="Bold" Foreground="#BFFFFFFF" />
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Style="{StaticResource GlassButton}" Width="40" Height="40" Click="OnBack10"
                            ToolTipService.ToolTip="Reculer de 10 s (←)" AutomationProperties.Name="Reculer de 10 secondes">
                        <Grid>
                            <FontIcon Glyph="&#xE72C;" FontSize="18" Foreground="White" RenderTransformOrigin="0.5,0.5">
                                <FontIcon.RenderTransform>
                                    <ScaleTransform ScaleX="-1" />
                                </FontIcon.RenderTransform>
                            </FontIcon>
                            <TextBlock Text="10" FontSize="7" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="PlayPauseButton" Click="OnTogglePause" AutomationProperties.Name="Lecture ou pause"
                            ToolTipService.ToolTip="Lecture / pause (Espace)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="54" Height="54">
                                    <Ellipse Fill="White" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                        <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE769;" FontSize="20" Foreground="Black" />
                    </Button>
                    <Button x:Name="ForwardButton" Style="{StaticResource GlassButton}" Width="40" Height="40" Click="OnForward10"
                            ToolTipService.ToolTip="Avancer de 10 s (→)" AutomationProperties.Name="Avancer de 10 secondes">
                        <Grid>
                            <FontIcon Glyph="&#xE72C;" FontSize="18" Foreground="White" />
                            <TextBlock Text="10" FontSize="7" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource GlassButton}" Width="40" Height="40" Visibility="Collapsed"
                            Click="OnPlayNext" ToolTipService.ToolTip="Épisode suivant (N)" AutomationProperties.Name="Épisode suivant">
                        <FontIcon Glyph="&#xE893;" FontSize="14" Foreground="White" />
                    </Button>
                </StackPanel>

                <!-- Film: "12:04 / 1:58:00"; live: "Direct". -->
                <StackPanel x:Name="TimeLabel" Grid.Column="2" Orientation="Horizontal" Spacing="4" MinWidth="130"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TimePosition" Text="0:00" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="/" FontSize="12" FontWeight="SemiBold" Foreground="#66FFFFFF" />
                    <TextBlock x:Name="TimeDuration" Text="0:00" FontSize="12" FontWeight="SemiBold" Foreground="#BFFFFFFF" />
                </StackPanel>
                <Border x:Name="LiveLabel" Grid.Column="2" Background="{StaticResource GlassFill}" BorderBrush="#1FFFFFFF"
                        BorderThickness="1" CornerRadius="999" Padding="10,6" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE720;" FontSize="11" Foreground="#E6FFFFFF" />
                        <TextBlock x:Name="LiveLabelText" Text="Direct" FontSize="12" FontWeight="SemiBold" Foreground="#E6FFFFFF" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="{StaticResource GlassFill}" BorderBrush="#1FFFFFFF" BorderThickness="1"
                        CornerRadius="999" Padding="8,2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="MuteButton" Click="OnToggleMute" ToolTipService.ToolTip="Muet (M)" AutomationProperties.Name="Muet">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Width="32" Height="32" Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                            <FontIcon x:Name="VolumeIcon" Glyph="&#xE995;" FontSize="13" Foreground="White" />
                        </Button>
                        <player:SeekSlider x:Name="VolumeSlider" Width="100" AutomationProperties.Name="Volume" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Cast banner, top centre. -->
        <Grid x:Name="CastBanner" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0" Visibility="Collapsed">
            <Border x:Name="CastPlaying" Background="#BF000000" Padding="22,8">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <FontIcon Glyph="&#xE7F4;" FontSize="14" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock x:Name="CastText" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Style="{StaticResource VeltrioGhostButton}" Foreground="White" BorderBrush="White" Click="OnStopCasting"
                            Padding="12,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71A;" FontSize="9" />
                            <TextBlock Text="ARRÊTER" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <Border x:Name="CastFailed" Background="#D9E5484D" Padding="22,8" Visibility="Collapsed">
                <TextBlock x:Name="CastError" Foreground="White" FontSize="12" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <!-- Live: the playlist's channels, to zap without leaving (L). -->
        <Grid x:Name="ChannelPanel" Width="340" HorizontalAlignment="Right" Background="{StaticResource PanelFill}"
              Visibility="Collapsed" Padding="0,70,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="14,0,14,8">
                <TextBlock x:Name="ChannelPanelTitle" Text="CHAÎNES" FontSize="10" FontWeight="Bold" CharacterSpacing="240"
                           Foreground="#E6FFFFFF" VerticalAlignment="Center" />
                <Button Style="{StaticResource PanelCloseButton}" HorizontalAlignment="Right" Click="OnToggleChannels"
                        AutomationProperties.Name="Fermer les chaînes" />
            </Grid>
            <!-- What's on screen: its bouquet and the channel. A click brings
                 the list back to that bouquet. -->
            <Button x:Name="CurrentChannelCard" Grid.Row="1" Margin="14,0,14,10" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" Click="OnShowCurrentChannel" AutomationProperties.Name="Chaîne en cours">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#1AFFFFFF" BorderBrush="#E6A84B" BorderThickness="2,0,0,0" Padding="10,8">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="44" Height="30" Background="#14FFFFFF" VerticalAlignment="Center">
                        <Image x:Name="CurrentChannelLogo" Stretch="Uniform" Margin="3" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="CurrentChannelGroup" FontSize="9" FontWeight="Bold" CharacterSpacing="160" Foreground="#E6A84B"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="CurrentChannelName" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Button>
            <ComboBox x:Name="ChannelGroups" Grid.Row="2" Margin="14,0,14,6" HorizontalAlignment="Stretch"
                      SelectionChanged="OnChannelFilter" AutomationProperties.Name="Bouquet" />
            <TextBox x:Name="ChannelSearch" Grid.Row="3" Margin="14,0,14,8" PlaceholderText="Chercher une chaîne"
                     TextChanged="OnChannelFilter" AutomationProperties.Name="Chercher une chaîne" />
            <ListView x:Name="ZapList" Grid.Row="4" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnZapClick"
                      ItemTemplate="{StaticResource ZapTemplate}" ItemContainerStyle="{StaticResource VeltrioRowListItem}" />
        </Grid>

        <!-- Live: catch-up, past programmes the provider keeps. -->
        <Grid x:Name="ReplayPanel" Width="400" HorizontalAlignment="Right" Background="{StaticResource PanelFill}"
              BorderBrush="{StaticResource PanelStroke}" BorderThickness="1,0,0,0" Visibility="Collapsed" Padding="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="REPLAY" Style="{StaticResource PanelEyebrow}" />
                <Button Style="{StaticResource PanelCloseButton}" HorizontalAlignment="Right" Click="OnReplay"
                        AutomationProperties.Name="Fermer le replay" />
            </Grid>
            <TextBlock x:Name="ReplayHint" Grid.Row="1" Margin="0,14,0,0" FontSize="11" Foreground="#99FFFFFF" TextWrapping="Wrap"
                       Text="Revenez à n'importe quel programme des dernières 24 heures." />
            <Rectangle Grid.Row="2" Height="1" Fill="#26FFFFFF" Margin="0,14,0,8" />
            <ProgressRing x:Name="ReplayLoading" Grid.Row="3" IsActive="False" Width="22" Height="22" VerticalAlignment="Top" />
            <ListView x:Name="ReplayList" Grid.Row="3" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnReplayClick"
                      ItemTemplate="{StaticResource ReplayTemplate}" ItemContainerStyle="{StaticResource VeltrioRowListItem}" />
        </Grid>

        <!-- Media info: codecs, resolution, HDR, tracks (I). -->
        <Grid x:Name="InfoPanel" Width="340" HorizontalAlignment="Right" Background="{StaticResource PanelFill}"
              BorderBrush="{StaticResource PanelStroke}" BorderThickness="1,0,0,0" Visibility="Collapsed" Padding="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="INFOS MÉDIA" Style="{StaticResource PanelEyebrow}" />
                <Button Style="{StaticResource PanelCloseButton}" HorizontalAlignment="Right" Click="OnToggleInfo"
                        AutomationProperties.Name="Fermer les infos" />
            </Grid>
            <Rectangle Grid.Row="1" Height="1" Fill="#26FFFFFF" Margin="0,14,0,14" />
            <ScrollViewer Grid.Row="2">
                <StackPanel x:Name="InfoLines" Spacing="10" />
            </ScrollViewer>
            <TextBlock x:Name="InfoProfile" Grid.Row="3" FontSize="10" Foreground="#80FFFFFF" Margin="0,14,0,0" />
        </Grid>

        <!-- End of an episode. -->
        <Grid x:Name="NextOverlay" Background="#B3000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22" MaxWidth="620">
                <FontIcon Glyph="&#xE930;" FontSize="56" Foreground="#E6A84B" HorizontalAlignment="Center" />
                <TextBlock Text="Épisode terminé" FontSize="28" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" />
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock x:Name="NextTitle" FontSize="14" FontWeight="SemiBold" Foreground="#E6FFFFFF" TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="NextCountdown" FontSize="13" FontWeight="SemiBold" Foreground="#B3FFFFFF" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                    <Button Style="{StaticResource CapsuleButton}" Click="OnCancelNext" Padding="22,12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71A;" FontSize="11" />
                            <TextBlock Text="Rester ici" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PlayNextButton" Style="{StaticResource CapsuleButton}" Click="OnPlayNext" Padding="22,12"
                            Background="White" Foreground="Black">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="11" />
                            <TextBlock Text="Épisode suivant" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
