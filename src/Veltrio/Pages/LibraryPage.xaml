<Page
    x:Class="Veltrio.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="48,32,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="10" Padding="0,0,48,24">
            <TextBlock x:Name="Eyebrow" Style="{StaticResource VeltrioAccentEyebrow}" />
            <TextBlock Text="Collection" Style="{StaticResource VeltrioPageTitle}" />
            <!-- The titles saved in the app, or a connected media server's own libraries. -->
            <StackPanel x:Name="SourceTabs" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" Visibility="Collapsed" />
            <Grid x:Name="SavedFilters" Margin="0,8,0,0">
                <StackPanel x:Name="FilterChips" Orientation="Horizontal" Spacing="8" />
                <StackPanel x:Name="TypeChips" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" />
            </Grid>
            <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                <StackPanel x:Name="SectionChips" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" />
            </ScrollViewer>
            <Border Style="{StaticResource VeltrioRule}" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel x:Name="EmptyState" Grid.Row="1" Spacing="18" Padding="0,24,48,0" MaxWidth="560" HorizontalAlignment="Left"
                    Visibility="Collapsed">
            <TextBlock x:Name="EmptyTitle" Text="Rien d'enregistré,&#x0a;pour l'instant." Style="{StaticResource VeltrioPageTitle}"
                       FontSize="38" />
            <TextBlock x:Name="EmptyBody" Style="{StaticResource VeltrioBody}"
                       Text="Enregistrez un titre depuis sa fiche : il arrive ici, avec tout ce que vous avez commencé à regarder." />
        </StackPanel>

        <GridView x:Name="Items" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick"
                  ItemTemplate="{StaticResource LibraryTemplate}" ItemContainerStyle="{StaticResource VeltrioBareGridItem}"
                  Padding="0,0,30,40" RightTapped="OnItemRightTapped" />

        <ProgressRing x:Name="ServerLoading" Grid.Row="1" Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Margin="0,24,0,0" />
        <GridView x:Name="ServerItems" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnServerItemClick"
                  ItemTemplate="{StaticResource PosterTemplate}" ItemContainerStyle="{StaticResource VeltrioBareGridItem}"
                  Padding="0,0,30,40" Visibility="Collapsed">
            <GridView.Footer>
                <Button x:Name="LoadMore" Style="{StaticResource VeltrioGhostButton}" Margin="0,18,0,0" Visibility="Collapsed"
                        Click="OnLoadMore">
                    <TextBlock Text="CHARGER LA SUITE" />
                </Button>
            </GridView.Footer>
        </GridView>
    </Grid>
</Page>
