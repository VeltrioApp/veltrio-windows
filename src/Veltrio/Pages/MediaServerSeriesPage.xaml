<Page
    x:Class="Veltrio.Pages.MediaServerSeriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- {Binding}: see DetailPage.xaml about x:Bind in page templates. -->
        <DataTemplate x:Key="EpisodeTemplate">
            <Grid Padding="0,12" ColumnSpacing="18" BorderBrush="{StaticResource VeltrioBorderBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="176" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Height="99" Background="{StaticResource VeltrioSurfaceBrush}" VerticalAlignment="Top">
                    <FontIcon Glyph="&#xE8B2;" FontSize="20" Foreground="{StaticResource VeltrioTextQuaternaryBrush}" />
                    <Image Source="{Binding Image}" Stretch="UniformToFill" />
                    <ProgressBar Value="{Binding Progress}" Maximum="100" VerticalAlignment="Bottom" MinHeight="2" Height="2"
                                 CornerRadius="0" Background="Transparent" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Code}" Style="{StaticResource VeltrioNumeral}" FontSize="10" />
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource VeltrioSerif}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource VeltrioTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer>
            <StackPanel Padding="48,28,48,48" Spacing="20">
                <Button Style="{StaticResource VeltrioLinkButton}" Click="OnBack">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="9" />
                        <TextBlock Text="RETOUR" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Rectangle Width="28" Height="1" Fill="{StaticResource VeltrioAccentBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="SourceEyebrow" Style="{StaticResource VeltrioAccentEyebrow}" />
                    <TextBlock Text="· SÉRIE" Style="{StaticResource VeltrioEyebrow}" />
                </StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource VeltrioPageTitle}" FontSize="40" MaxLines="3" />
                <TextBlock x:Name="YearText" Style="{StaticResource VeltrioCaption}" />
                <Grid Width="200" Height="300" HorizontalAlignment="Left" Background="{StaticResource VeltrioSurfaceBrush}">
                    <Image x:Name="Cover" Stretch="UniformToFill" />
                </Grid>
                <Border Style="{StaticResource VeltrioRule}" />
                <Button x:Name="PlayButton" Style="{StaticResource VeltrioPrimaryButton}" HorizontalAlignment="Stretch"
                        IsEnabled="False" Click="OnPlay">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                        <TextBlock x:Name="PlayLabel" Text="CHARGEMENT" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <Rectangle Grid.Column="1" Fill="{StaticResource VeltrioBorderBrush}" />

        <Grid Grid.Column="2" Padding="48,28,48,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="14" Padding="0,0,0,10">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock Text="ÉPISODES" Style="{StaticResource VeltrioAccentEyebrow}" VerticalAlignment="Center" />
                    <TextBlock x:Name="EpisodeCount" Style="{StaticResource VeltrioEyebrow}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="SeasonChips" Orientation="Horizontal" Spacing="8" />
            </StackPanel>
            <ProgressRing x:Name="Loading" Grid.Row="1" IsActive="True" Width="26" Height="26" HorizontalAlignment="Left"
                          VerticalAlignment="Top" />
            <TextBlock x:Name="EmptyText" Grid.Row="1" Style="{StaticResource VeltrioBody}" Visibility="Collapsed"
                       Text="Aucun épisode." />
            <ListView x:Name="EpisodeList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnEpisodeClick"
                      ItemTemplate="{StaticResource EpisodeTemplate}" ItemContainerStyle="{StaticResource VeltrioRowListItem}"
                      Padding="0,0,0,40" />
        </Grid>
    </Grid>
</Page>
