<Page
    x:Class="Veltrio.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource VeltrioPagePadding}" Spacing="44" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Spacing="10">
                <Button Style="{StaticResource VeltrioLinkButton}" Click="OnBack">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="9" />
                        <TextBlock Text="RETOUR" />
                    </StackPanel>
                </Button>
                <TextBlock Text="PRÉFÉRENCES" Style="{StaticResource VeltrioAccentEyebrow}" Margin="0,8,0,0" />
                <TextBlock Text="Réglages" Style="{StaticResource VeltrioPageTitle}" />
                <Border Style="{StaticResource VeltrioRule}" Margin="0,8,0,0" />
            </StackPanel>

            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock Text="01 —" Style="{StaticResource VeltrioNumeral}" VerticalAlignment="Center" />
                    <TextBlock Text="Sources" Style="{StaticResource VeltrioSectionTitle}" />
                </StackPanel>
                <TextBlock Style="{StaticResource VeltrioBody}"
                           Text="Les addons Stremio et les playlists IPTV se gèrent dans l'onglet Sources." />
                <Button Style="{StaticResource VeltrioGhostButton}" Click="OnOpenSources" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="OUVRIR LES SOURCES" />
                        <FontIcon Glyph="&#xE72A;" FontSize="10" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock Text="02 —" Style="{StaticResource VeltrioNumeral}" VerticalAlignment="Center" />
                    <TextBlock Text="Debrid" Style="{StaticResource VeltrioSectionTitle}" />
                </StackPanel>
                <TextBlock Style="{StaticResource VeltrioBody}"
                           Text="Un service debrid lit les torrents en direct depuis ses serveurs, en HTTPS, sans partage pair à pair. Les flux qu'il a déjà en cache sont marqués ⚡ et passent en tête. Les clés restent sur cet appareil, chiffrées pour votre session Windows." />
                <StackPanel x:Name="DebridCards" Spacing="12" />
            </StackPanel>

            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock Text="03 —" Style="{StaticResource VeltrioNumeral}" VerticalAlignment="Center" />
                    <TextBlock Text="Comptes" Style="{StaticResource VeltrioSectionTitle}" />
                </StackPanel>
                <TextBlock Style="{StaticResource VeltrioBody}"
                           Text="Importez votre bibliothèque dans la Collection et suivez ce que vous regardez. L'import ne fait qu'ajouter : il ne retire rien et ne remet aucune progression à zéro." />
                <StackPanel x:Name="AccountCards" Spacing="12" />
            </StackPanel>

            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock Text="04 —" Style="{StaticResource VeltrioNumeral}" VerticalAlignment="Center" />
                    <TextBlock Text="Lecture" Style="{StaticResource VeltrioSectionTitle}" />
                </StackPanel>
                <TextBlock Style="{StaticResource VeltrioBody}"
                           Text="Le lecteur s'appuie sur mpv, comme sur macOS : MKV, HEVC, HDR, pistes audio et sous-titres intégrés, décodage matériel quand la carte graphique le permet. Ces choix valent pour la prochaine vidéo ouverte." />
                <Grid ColumnSpacing="18" RowSpacing="14" Width="720" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ComboBox x:Name="AudioLang" Header="Langue audio préférée" HorizontalAlignment="Stretch" SelectionChanged="OnPlaybackChanged" />
                    <ComboBox x:Name="SubtitleLang" Grid.Column="1" Header="Sous-titres préférés" HorizontalAlignment="Stretch"
                              SelectionChanged="OnPlaybackChanged" />
                    <ComboBox x:Name="SubtitleScale" Grid.Row="1" Header="Taille des sous-titres" HorizontalAlignment="Stretch" SelectionChanged="OnPlaybackChanged" />
                    <ComboBox x:Name="SubtitleColor" Grid.Row="1" Grid.Column="1" Header="Couleur des sous-titres" HorizontalAlignment="Stretch"
                              SelectionChanged="OnPlaybackChanged" />
                    <ComboBox x:Name="Hwdec" Grid.Row="2" Header="Décodage vidéo" HorizontalAlignment="Stretch" SelectionChanged="OnPlaybackChanged" />
                    <ComboBox x:Name="CacheSize" Grid.Row="2" Grid.Column="1" Header="Mémoire tampon (flux réseau)" HorizontalAlignment="Stretch"
                              SelectionChanged="OnPlaybackChanged" />
                </Grid>
                <ToggleSwitch x:Name="AutoNext" Header="Enchaîner l'épisode suivant (compte à rebours de 10 s en fin d'épisode)"
                              OnContent="Oui" OffContent="Non" Toggled="OnPlaybackChanged" />
                <TextBlock Style="{StaticResource VeltrioBody}" FontSize="12"
                           Text="Des sous-titres d'addons dans la langue choisie s'ajoutent quand le fichier n'en a pas et que l'audio n'est pas déjà dans cette langue. Raccourcis, comme sur macOS : Espace lecture/pause · ← → 10 s en arrière / en avant · ↑ ↓ volume · M couper le son · Z X décaler les sous-titres · [ ] vitesse · A format d'image · S passer l'intro · N épisode suivant · I infos média · L chaînes · G programme en cours · Pg préc./Pg suiv. changer de chaîne · F plein écran · Échap quitter." />
            </StackPanel>

            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock Text="05 —" Style="{StaticResource VeltrioNumeral}" VerticalAlignment="Center" />
                    <TextBlock Text="Apparence" Style="{StaticResource VeltrioSectionTitle}" />
                </StackPanel>
                <TextBlock Style="{StaticResource VeltrioBody}"
                           Text="Langue de l'application (synchronise aussi les catalogues TMDB)." />
                <StackPanel x:Name="LanguageChips" Orientation="Horizontal" Spacing="8" />
                <TextBlock Style="{StaticResource VeltrioBody}"
                           Text="Sombre : le noir de salle de cinéma, l'expérience de référence. Clair : un papier chaud pour la journée. Le thème change au prochain lancement." />
                <StackPanel x:Name="ThemeChips" Orientation="Horizontal" Spacing="8" />
                <Button x:Name="RestartButton" Style="{StaticResource VeltrioGhostButton}" HorizontalAlignment="Left" Click="OnRestart"
                        Visibility="Collapsed">
                    <TextBlock Text="RELANCER MAINTENANT" />
                </Button>
                <StackPanel x:Name="ParentalHost" Spacing="10" Margin="0,12,0,0" />
            </StackPanel>

            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock Text="06 —" Style="{StaticResource VeltrioNumeral}" VerticalAlignment="Center" />
                    <TextBlock Text="Stockage" Style="{StaticResource VeltrioSectionTitle}" />
                </StackPanel>
                <TextBlock Style="{StaticResource VeltrioBody}"
                           Text="Addons, playlists, comptes, collection et progression sont enregistrés sur cet appareil uniquement." />
                <TextBlock x:Name="DataFolder" FontFamily="{StaticResource VeltrioMono}" FontSize="12" IsTextSelectionEnabled="True"
                           Foreground="{StaticResource VeltrioTextSecondaryBrush}" />
                <Button Style="{StaticResource VeltrioGhostButton}" Click="OnOpenFolder" HorizontalAlignment="Left">
                    <TextBlock Text="OUVRIR LE DOSSIER" />
                </Button>
                <TextBlock Text="TÉLÉCHARGEMENTS" Style="{StaticResource VeltrioEyebrow}" Margin="0,8,0,0" />
                <TextBlock x:Name="NoDownloads" Style="{StaticResource VeltrioBody}" FontSize="12"
                           Text="Aucun téléchargement. Clic droit sur un flux, dans la fiche d'un titre, puis « Télécharger pour regarder hors ligne »." />
                <StackPanel x:Name="DownloadList" Spacing="8" />
                <TextBlock Style="{StaticResource VeltrioBody}" Margin="0,8,0,0"
                           Text="Les torrents lus sans debrid sont téléchargés dans un dossier temporaire, gardé pour reprendre plus vite. Le vider libère la place ; un torrent en cours de lecture n'est pas touché." />
                <TextBlock x:Name="TorrentCache" FontFamily="{StaticResource VeltrioMono}" FontSize="12" IsTextSelectionEnabled="True"
                           Foreground="{StaticResource VeltrioTextSecondaryBrush}" />
                <Button x:Name="ClearCacheButton" Style="{StaticResource VeltrioGhostButton}" Click="OnClearCache" HorizontalAlignment="Left">
                    <TextBlock Text="VIDER LE CACHE DES TORRENTS" />
                </Button>
            </StackPanel>

            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock Text="07 —" Style="{StaticResource VeltrioNumeral}" VerticalAlignment="Center" />
                    <TextBlock Text="À propos" Style="{StaticResource VeltrioSectionTitle}" />
                </StackPanel>
                <TextBlock x:Name="Versions" FontFamily="{StaticResource VeltrioMono}" FontSize="12"
                           Foreground="{StaticResource VeltrioTextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,4">
                    <Button x:Name="UpdateButton" Style="{StaticResource VeltrioGhostButton}" Click="OnUpdate">
                        <TextBlock x:Name="UpdateLabel" Text="RECHERCHER UNE MISE À JOUR" />
                    </Button>
                    <Button Style="{StaticResource VeltrioGhostButton}" Click="OnShowOnboarding">
                        <TextBlock Text="AFFICHER L'ASSISTANT DE BIENVENUE" />
                    </Button>
                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource VeltrioBody}" FontSize="12" VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Style="{StaticResource VeltrioBody}" FontSize="12"
                           Text="Veltrio ne fournit aucun contenu : il affiche ce que renvoient les sources que vous installez." />
                <TextBlock Style="{StaticResource VeltrioBody}" FontSize="12"
                           Text="Lecture par libmpv (LGPL 2.1+, mpv.io), rendu via ANGLE (BSD). Le journal du lecteur est dans le dossier de données (player.log)." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
