<Page
    x:Class="Veltrio.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Veltrio.Services">

    <ScrollViewer Padding="48,24,48,48">
        <StackPanel Spacing="28">
            <StackPanel Spacing="6">
                <TextBlock Text="NOW SHOWING" Style="{StaticResource VeltrioEyebrow}" />
                <TextBlock Text="Home" Style="{StaticResource VeltrioPageTitle}" />
                <TextBlock x:Name="CoreVersionText" Opacity="0.55" FontSize="12" />
                <Border Height="1" Background="{StaticResource VeltrioHairlineBrush}" Margin="0,8,0,0" />
            </StackPanel>

            <ProgressRing x:Name="Loading" IsActive="True" HorizontalAlignment="Left" />
            <InfoBar x:Name="ErrorBar" Severity="Error" Title="Couldn't load the catalogs" IsClosable="False" />

            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="services:CatalogRow">
                        <StackPanel Spacing="12" Margin="0,0,0,28">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource VeltrioSectionTitle}" />
                                <TextBlock Text="{x:Bind Subtitle}" Opacity="0.5" FontSize="11"
                                           VerticalAlignment="Bottom" Margin="0,0,0,4" />
                            </StackPanel>
                            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
                                <ItemsRepeater ItemsSource="{x:Bind Items}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="14" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="services:PosterItem">
                                            <StackPanel Width="160" Spacing="8">
                                                <Border Height="240" Background="#141414"
                                                        BorderBrush="{StaticResource VeltrioHairlineBrush}" BorderThickness="1">
                                                    <!-- {Binding}: x:Bind won't turn a URL string into an ImageSource. -->
                                                    <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Subtitle}" Opacity="0.5" FontSize="11" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
