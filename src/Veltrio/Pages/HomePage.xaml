<Page
    x:Class="Veltrio.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Veltrio.Pages"
    NavigationCacheMode="Enabled">

    <ScrollViewer>
        <StackPanel Padding="0,0,0,60">

            <!-- Nothing installed: the macOS empty state. -->
            <StackPanel x:Name="EmptyState" Visibility="Collapsed" Padding="48,80,48,0" Spacing="22" MaxWidth="1560"
                        HorizontalAlignment="Left">
                <TextBlock Text="00 —" Style="{StaticResource VeltrioNumeral}" FontSize="13" />
                <TextBlock Text="Une pièce calme,&#x0a;rien à l'écran." Style="{StaticResource VeltrioPageTitle}"
                           FontSize="52" CharacterSpacing="-25" />
                <Border Style="{StaticResource VeltrioRule}" MaxWidth="420" HorizontalAlignment="Stretch" />
                <TextBlock MaxWidth="480" HorizontalAlignment="Left" FontSize="15" Style="{StaticResource VeltrioBody}"
                           Text="Connectez votre clé API TMDB gratuite (themoviedb.org/settings/api) pour afficher les films, séries, résumés et la recherche dans votre langue." />
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
                    <PasswordBox x:Name="TmdbKeyInput" Width="320" PlaceholderText="Clé API ou jeton TMDB…" />
                    <Button x:Name="ConnectTmdb" Style="{StaticResource VeltrioPrimaryButton}" Click="OnConnectTmdb">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;" FontSize="11" />
                            <TextBlock Text="CONNECTER TMDB" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource VeltrioGhostButton}" Click="OnOpenSources">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="OUVRIR LES SOURCES" />
                            <FontIcon Glyph="&#xE72A;" FontSize="10" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="EmptyError" Foreground="{StaticResource VeltrioDangerBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Editorial hero: still bleeding off the right, hard left wipe,
                 serif title bottom-left. -->
            <Grid x:Name="Hero" Height="560" Visibility="Collapsed">
                <Image x:Name="HeroImage" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Top" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{StaticResource VeltrioCanvasColor}" Offset="0" />
                            <GradientStop Color="{StaticResource VeltrioCanvasColor}" Offset="0.28" />
                            <GradientStop Color="{StaticResource VeltrioCanvas80Color}" Offset="0.42" />
                            <GradientStop Color="{StaticResource VeltrioCanvas0Color}" Offset="0.7" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Height="180" VerticalAlignment="Bottom">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{StaticResource VeltrioCanvas0Color}" Offset="0" />
                            <GradientStop Color="{StaticResource VeltrioCanvasColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <StackPanel MaxWidth="900" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="48,0,48,24">
                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,22">
                        <Rectangle Width="36" Height="1" Fill="{StaticResource VeltrioAccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="À L'AFFICHE" Style="{StaticResource VeltrioAccentEyebrow}" />
                        <TextBlock x:Name="HeroSource" Style="{StaticResource VeltrioEyebrow}" CharacterSpacing="200" />
                    </StackPanel>
                    <TextBlock x:Name="HeroTitle" FontFamily="{StaticResource VeltrioSerif}" FontSize="72" FontWeight="Bold"
                               CharacterSpacing="-30" LineHeight="76" MaxLines="2" TextWrapping="Wrap"
                               TextTrimming="WordEllipsis" Foreground="{StaticResource VeltrioTextPrimaryBrush}" />
                    <Rectangle Width="280" Height="1" Fill="{StaticResource VeltrioHairlineBrush}" HorizontalAlignment="Left" Margin="0,22,0,0" />
                    <TextBlock x:Name="HeroFacts" Margin="0,14,0,0" FontFamily="{StaticResource VeltrioMono}" FontSize="12"
                               CharacterSpacing="80" Foreground="{StaticResource VeltrioTextSecondaryBrush}" />
                    <TextBlock x:Name="HeroDescription" Margin="0,22,0,0" MaxWidth="580" HorizontalAlignment="Left"
                               FontSize="15" MaxLines="3" TextTrimming="WordEllipsis" Style="{StaticResource VeltrioBody}"
                               Foreground="{StaticResource VeltrioTextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,22,0,0">
                        <Button x:Name="HeroWatch" Style="{StaticResource VeltrioPrimaryButton}" Padding="26,15" Click="OnHeroOpen">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE768;" FontSize="12" />
                                <TextBlock x:Name="HeroWatchLabel" Text="REGARDER" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource VeltrioGhostButton}" Click="OnHeroOpen">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE946;" FontSize="11" />
                                <TextBlock Text="DÉTAILS" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="RowsPanel" Padding="48,40,0,0" Spacing="52">
                <!-- 01 — Continue watching, when something is in progress. -->
                <StackPanel x:Name="ContinueSection" Spacing="14" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="01 —" Style="{StaticResource VeltrioNumeral}" VerticalAlignment="Center" />
                        <TextBlock Text="Reprendre" Style="{StaticResource VeltrioSectionTitle}" />
                        <TextBlock x:Name="ContinueCount" Style="{StaticResource VeltrioEyebrow}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListView x:Name="ContinueList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnContinueClick"
                              ItemTemplate="{StaticResource ContinueTemplate}"
                              ItemContainerStyle="{StaticResource VeltrioBareListItem}"
                              local:WheelScroll.PassToPage="True" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                              ScrollViewer.IsVerticalScrollChainingEnabled="True">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                </StackPanel>

                <ItemsControl x:Name="Rows">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="52" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:HomeRow">
                            <StackPanel Spacing="14">
                                <Grid Padding="0,0,48,0">
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <TextBlock Text="{x:Bind Number}" Style="{StaticResource VeltrioNumeral}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource VeltrioSectionTitle}" />
                                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource VeltrioEyebrow}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Style="{StaticResource VeltrioLinkButton}"
                                            Visibility="{x:Bind SeeAllVisibility, Mode=OneWay}" Tag="{x:Bind}" Click="OnSeeAll">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="TOUT VOIR" />
                                            <FontIcon Glyph="&#xE72A;" FontSize="9" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ProgressRing IsActive="True" Width="20" Height="20" HorizontalAlignment="Left"
                                              Visibility="{x:Bind LoadingVisibility, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Message, Mode=OneWay}" Visibility="{x:Bind MessageVisibility, Mode=OneWay}"
                                           FontSize="12" Foreground="{StaticResource VeltrioTextTertiaryBrush}" />
                                <ListView ItemsSource="{x:Bind Items, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True"
                                          ItemClick="OnPosterClick" ItemTemplate="{StaticResource PosterTemplate}"
                                          ItemContainerStyle="{StaticResource VeltrioBareListItem}"
                                          local:WheelScroll.PassToPage="True" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                          ScrollViewer.IsVerticalScrollChainingEnabled="True">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsStackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                </ListView>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
