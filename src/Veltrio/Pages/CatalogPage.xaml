<Page
    x:Class="Veltrio.Pages.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="48,28,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="10" Padding="0,0,48,22">
            <Button Style="{StaticResource VeltrioLinkButton}" Click="OnBack">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="9" />
                    <TextBlock Text="RETOUR" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="Eyebrow" Style="{StaticResource VeltrioAccentEyebrow}" Margin="0,8,0,0" />
            <TextBlock x:Name="TitleText" Style="{StaticResource VeltrioPageTitle}" />
            <Border Style="{StaticResource VeltrioRule}" />
        </StackPanel>

        <GridView x:Name="PosterGrid" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnPosterClick"
                  ItemTemplate="{StaticResource PosterTemplate}" ItemContainerStyle="{StaticResource VeltrioBareGridItem}"
                  Padding="0,0,30,40">
            <GridView.Footer>
                <StackPanel Padding="0,10,0,40" Spacing="12">
                    <ProgressRing x:Name="Loading" IsActive="False" Width="22" Height="22" HorizontalAlignment="Left" />
                    <Button x:Name="LoadMore" Style="{StaticResource VeltrioGhostButton}" Click="OnLoadMore" Visibility="Collapsed">
                        <TextBlock Text="CHARGER PLUS" />
                    </Button>
                </StackPanel>
            </GridView.Footer>
        </GridView>
    </Grid>
</Page>
